{
  "schemaVersion": 38,
  "title": "LaunchPad SLOs",
  "timezone": "browser",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "type": "timeseries",
      "title": "P95 latency (s)",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 9 },
      "targets": [{ "refId": "A", "expr": "slo:http_request_duration_seconds:p95:5m" }]
    },
    {
      "type": "timeseries",
      "title": "Error rate (5xx, %)",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 9 },
      "targets": [{ "refId": "A", "expr": "100 * sli:http_error_rate:ratio:5m" }]
    }
  ]
}
